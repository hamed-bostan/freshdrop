# ── FreshDrop production environment ──────────────────────────────────
# Copy to `.env.production` ON THE SERVER and fill in real values.
# This .example file is safe to commit; the real `.env.production` is NOT
# (it stays gitignored and lives only on the VPS).

# ── SMS.ir (OTP login) ────────────────────────────────────────────────
# REQUIRED in production. Without SMS_IR_API_KEY the app falls back to a
# mock OTP that reveals the login code in the UI — insecure for a public site.
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=562447
# SMS_IR_BASE_URL=          # optional; leave unset to use the default

# ── SMS.ir (transactional order notifications) ────────────────────────
# Approved pattern-template ids for each order event, reusing SMS_IR_API_KEY
# above. Any left unset just skips SMS for that event (a logging stub still
# records it). Each approved template's parameters should match what the app
# fills: #ORDER# (short order ref) and, for the first two, #WINDOW# (slot).
# SMS_IR_ORDER_CONFIRMED_TEMPLATE_ID=
# SMS_IR_ORDER_SHIPPED_TEMPLATE_ID=
# SMS_IR_ORDER_DELIVERED_TEMPLATE_ID=
# SMS_IR_RETURN_APPROVED_TEMPLATE_ID=

# ── Supabase Storage (product/category images) ───────────────────────
# Project URL and publishable key are public (safe in the browser bundle).
# SUPABASE_SECRET_KEY is the service-role key — server-only, NEVER expose it.
NEXT_PUBLIC_SUPABASE_URL=https://idcwhbjnvkoihxwjebxm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_IMAGES_BUCKET=images   # optional; defaults to "images"
#
# Orphan-image sweep (POST /api/admin/images/sweep). Reclaims bucket objects no
# category references — e.g. an icon uploaded for a form that was never saved.
# Admins can trigger it from a signed-in session; automation uses this bearer
# secret. Leave empty to disable unattended runs (admin-only). Wire to a daily
# host cron on the VPS:
#   curl -fsS -X POST -H "Authorization: Bearer $IMAGE_SWEEP_SECRET" \
#     https://nearfood.ir/api/admin/images/sweep
IMAGE_SWEEP_SECRET=
# IMAGE_SWEEP_MAX_AGE_HOURS=24    # optional; safety window, defaults to 24

# ── PostgreSQL (application data) ─────────────────────────────────────
# Self-hosted in the `db` container (see docker-compose.yml). POSTGRES_*
# configure the container; DATABASE_URL is what Prisma connects with —
# host `db` is the compose service name on the internal network.
POSTGRES_USER=freshdrop
POSTGRES_PASSWORD=
POSTGRES_DB=freshdrop
DATABASE_URL=postgresql://freshdrop:PASSWORD@db:5432/freshdrop?schema=public

# ── Admin dashboard access ────────────────────────────────────────────
# Comma-separated list of user ids allowed into /dashboard. A user's id is set
# at login: with the current phone-OTP setup it's the phone normalised to the
# local 09xxxxxxxxx form (a leading 98 country code becomes 0), e.g. "09121234567".
# Empty = nobody can reach the dashboard.
ADMIN_USER_IDS=

# ── Localization / currency ───────────────────────────────────────────
# Prices are stored as USD; under the Persian (fa) locale they render in Toman.
# This is the *starting* USD→Toman rate. Public so it inlines into the browser
# bundle (prices render client-side too). Optional — defaults to a placeholder
# rate in src/config/currency.ts when unset.
# NEXT_PUBLIC_USD_TOMAN=90000
#
# Optional live rate: when set, the app fetches a quote at request time (cached/
# revalidated hourly) and uses it instead of the fixed rate above; any failure
# falls back to it, so prices never break. The endpoint must return JSON
# {"tomanPerUsd": <number>}. NOTE: there is no reliable *free* feed for the
# Iranian free-market rate (standard FX APIs give the official IRR rate, ~10-20×
# off) — point this at your own small proxy over a source you trust.
# EXCHANGE_RATE_URL=https://your-proxy.example/usd-toman

# ── SEO ────────────────────────────────────────────────────────────────
# Absolute site origin, used as metadataBase so canonical/hreflang/OpenGraph
# URLs resolve to absolute links. Optional — unset renders relative URLs.
# NEXT_PUBLIC_SITE_URL=https://nearfood.ir

# ── Nominatim (address geocoding, server-side only) ───────────────────
# Public OSM requires a real identifying User-Agent with contact info,
# or it will rate-limit / block the server. Set this to something real.
NOMINATIM_USER_AGENT=FreshDrop/1.0 (+https://nearfood.ir)
# NOMINATIM_BASE_URL=       # optional; defaults to public OSM Nominatim
# NOMINATIM_LANGUAGE=en     # optional
